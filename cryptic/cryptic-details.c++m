export module cryptic:details;
import std;

// Nothing here is exported. The other partitions import :details and see all of it;
// importers of cryptic don't.
namespace cryptic::details {

// Module-friendly assertion functions using std::source_location (C++20)
// Works in modules without macros and can be used in constexpr contexts
// 
// Usage: expects(condition);  // Automatically captures source location
//        ensures(condition);
inline constexpr void expects(bool condition,
                              const std::source_location location = std::source_location::current()) noexcept
{
    if (condition) return;
    if consteval {
        // In consteval context, we can't use std::cerr or std::terminate
        // The condition must be true for the function to be valid in consteval
        // If false, the compiler will reject the consteval evaluation
    } else {
        // At runtime, terminate with message
        std::cerr << location.file_name() << ":" << location.line() 
                  << " in " << location.function_name() << std::endl;
        std::terminate();
    }
}

inline constexpr void ensures(bool condition,
                              const std::source_location location = std::source_location::current()) noexcept
{
    if (condition) return;
    if consteval {
        // In consteval context, invalid condition will cause compile error
    } else {
        std::cerr << location.file_name() << ":" << location.line()
                  << " in " << location.function_name() << std::endl;
        std::terminate();
    }
}

template<typename T>
concept text_character = std::same_as<std::remove_const_t<T>, char> or std::same_as<std::remove_const_t<T>, char8_t>;

// A pointer to or an array of char or char8_t, read up to the first NUL.
// An array is never read past its end.
template<typename Message>
concept c_string = (std::is_pointer_v<std::remove_cvref_t<Message>>
                    and text_character<std::remove_pointer_t<std::remove_cvref_t<Message>>>)
                or (std::is_array_v<std::remove_cvref_t<Message>>
                    and text_character<std::remove_extent_t<std::remove_cvref_t<Message>>>);

// A message the hashes and base64::encode accept: a C string, or anything std::span can view.
template<typename Message>
concept byte_source = c_string<Message> or requires(Message& message) { std::span{message}; };

template<byte_source Message>
inline constexpr auto to_bytes_span(Message&& message) noexcept
{
    using message_type = std::remove_cvref_t<Message>;
    if constexpr (c_string<Message> and std::is_array_v<message_type>)
    {
        using character = std::remove_const_t<std::remove_extent_t<message_type>>;
        constexpr auto capacity = std::extent_v<message_type>;
        const auto* nul = std::char_traits<character>::find(message, capacity, character{});
        return std::as_bytes(std::span{message, nul ? static_cast<std::size_t>(nul - message) : capacity});
    }
    else if constexpr (c_string<Message>)
    {
        return std::as_bytes(std::span{std::basic_string_view{message}});
    }
    else
    {
        auto view = std::span{message};
        using element = std::remove_cv_t<typename decltype(view)::element_type>;
        // std::byte is already a byte span. Skipping as_bytes avoids the
        // reinterpret_cast, so a byte range can be hashed in a constant expression.
        if constexpr (std::is_same_v<element, std::byte>)
        {
            return std::span<const std::byte>{view.data(), view.size()};
        }
        else
        {
            return std::as_bytes(view);
        }
    }
}

} // namespace cryptic::details
