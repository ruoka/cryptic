export module cryptic:sha1;
import std;
import :details;
import :digest;

// AArch64 SHA-1 instructions (sha1c, sha1p, sha1m, sha1h, sha1su0, sha1su1)
// ship with the same FEAT_SHA1 feature that __ARM_FEATURE_SHA2 reports.
// CRYPTIC_SCALAR_ONLY forces the portable scalar path.
//
// x86 SHA-NI (SHA1RNDS4, SHA1NEXTE, SHA1MSG1, SHA1MSG2) would be selected
// here on __SHA__, once an x86-64 machine is available to test it. The Linux
// CI target is Clang 21 on x86-64 and stays on the scalar code.
#if defined(__aarch64__) && defined(__ARM_FEATURE_SHA2) && !defined(CRYPTIC_SCALAR_ONLY)
#define CRYPTIC_AARCH64_SHA 1
#endif

export namespace cryptic {

class sha1
{
public:

    static constexpr std::size_t digest_size = 20;

    static constexpr std::size_t block_size = 64;

    using digest_type = cryptic::digest<digest_size>;

    constexpr sha1() noexcept = default;

    // Appends to the message.
    constexpr sha1& update(details::byte_message auto&& message) noexcept
    {
        auto bytes = details::to_bytes_span(message);
        const auto pending = pending_size();
        m_message_length += 8u * bytes.size(); // NOTE, bits

        if (pending > 0)
        {
            const auto taken = std::min(block_size - pending, bytes.size());
            std::ranges::copy(bytes.first(taken), m_pending.begin() + pending);
            if (pending + taken < block_size)
                return *this;
            transform(m_pending);
            bytes = bytes.subspan(taken);
        }

        std::ranges::copy(absorb(bytes), m_pending.begin());
        return *this;
    }

    // The digest of everything passed to update() so far. The hasher is left
    // as it was, so later update() calls continue the same message.
    [[nodiscard]] constexpr digest_type digest() const noexcept
    {
        auto last = *this;
        last.pad(std::span<const std::byte>{last.m_pending}.first(pending_size()));
        return last.to_digest();
    }

    [[nodiscard]] __attribute__((hot))
    static constexpr digest_type hash(details::byte_message auto&& message) noexcept
    {
        auto hasher = sha1{};
        const auto bytes = details::to_bytes_span(message);
        hasher.m_message_length = 8u * bytes.size(); // NOTE, bits

        // The tail may be empty. A multiple of the block size still needs a
        // padding block for the 0x80 marker and the bit length.
        hasher.pad(hasher.absorb(bytes));
        return hasher.to_digest();
    }

    [[nodiscard]] static constexpr std::string hexadecimal(details::byte_message auto&& message)
    {
        return hash(message).hexadecimal();
    }

    [[nodiscard]] static constexpr std::string base64(details::byte_message auto&& message)
    {
        return hash(message).base64();
    }

private:

    using message_length_type = std::uint64_t;

    constexpr digest_type to_digest() const noexcept
    {
        auto bytes = std::array<std::byte, digest_size>{};
        for(auto i = 0uz; i < m_message_digest.size(); ++i)
        {
            bytes[4 * i + 0] = static_cast<std::byte>(m_message_digest[i] >> 24);
            bytes[4 * i + 1] = static_cast<std::byte>(m_message_digest[i] >> 16);
            bytes[4 * i + 2] = static_cast<std::byte>(m_message_digest[i] >>  8);
            bytes[4 * i + 3] = static_cast<std::byte>(m_message_digest[i] >>  0);
        }
        return digest_type{bytes};
    }

    constexpr std::size_t pending_size() const noexcept
    {
        return static_cast<std::size_t>(m_message_length / 8u % block_size);
    }

    // Transforms every whole block and returns the bytes left over.
    __attribute__((hot, always_inline))
    constexpr std::span<const std::byte> absorb(std::span<const std::byte> bytes) noexcept
    {
        // Prefetch next block while processing current for better memory access
        const auto* __restrict data_ptr = bytes.data();
        auto offset = 0uz;
        while (offset + block_size <= bytes.size())
        {
            if not consteval
            {
                if (__builtin_expect(offset + 2 * block_size <= bytes.size(), 1))
                {
                    __builtin_prefetch(data_ptr + offset + block_size, 0, 3);
                }
            }
            transform(std::span<const std::byte, block_size>{data_ptr + offset, block_size});
            offset += block_size;
        }
        return bytes.subspan(offset);
    }

    __attribute__((hot, always_inline))
    constexpr void pad(std::span<const std::byte> last_chunk) noexcept
    {
        details::expects(last_chunk.size() < block_size);

        auto block = std::array<std::byte, 64>{};
        auto pos = std::ranges::copy(last_chunk, block.begin()).out;

        *pos++ = std::byte{0b10000000};

        const auto length_pos = block.begin() + 56;

        if (pos > length_pos) { // no room for length → need extra block
            std::fill(pos, block.end(), std::byte{0b00000000});
            transform(block);
            pos = block.begin();
        }

        std::fill(pos, length_pos, std::byte{0b00000000});
        encode(std::span{block}.subspan<56, 8>(), m_message_length);
        transform(block);
    }

    __attribute__((hot, always_inline))
    constexpr void transform(std::span<const std::byte,block_size> chunk) noexcept
    {
#if defined(CRYPTIC_AARCH64_SHA)
        if consteval
        {
            transform_scalar(chunk);
        }
        else
        {
            transform_asm(chunk);
        }
#else
        transform_scalar(chunk);
#endif
    }

#if defined(CRYPTIC_AARCH64_SHA)
    // Message words are big-endian, so rev32 runs on each 16-byte lane after
    // the load. sha1h saves rol(A, 30), which is the E input of the next four
    // rounds. Round constants are the four SHA-1 K values, duplicated per lane.
    __attribute__((hot, always_inline))
    void transform_asm(std::span<const std::byte, block_size> chunk) noexcept
    {
        auto* state = m_message_digest.data();
        const auto* block = chunk.data();
        const auto* constants = round_k.data();
        asm volatile(
            R"sha(
                ld1 {v19.4s}, [%[state]]
                ldr s23, [%[state], #16]
                mov v18.16b, v19.16b
                ld1 {v4.16b, v5.16b, v6.16b, v7.16b}, [%[block]]
                rev32 v4.16b, v4.16b
                rev32 v5.16b, v5.16b
                rev32 v6.16b, v6.16b
                rev32 v7.16b, v7.16b
                ldr w9, [%[k]]
                dup v0.4s, w9
                ldr w9, [%[k], #4]
                dup v1.4s, w9
                ldr w9, [%[k], #8]
                dup v2.4s, w9
                ldr w9, [%[k], #12]
                dup v3.4s, w9
                add v16.4s, v4.4s, v0.4s
                sha1su0 v4.4s, v5.4s, v6.4s
                add v17.4s, v5.4s, v0.4s
                sha1h s22, s19
                sha1c q19, s23, v16.4s
                sha1su1 v4.4s, v7.4s
                sha1su0 v5.4s, v6.4s, v7.4s
                add v16.4s, v6.4s, v0.4s
                sha1h s21, s19
                sha1c q19, s22, v17.4s
                sha1su1 v5.4s, v4.4s
                sha1su0 v6.4s, v7.4s, v4.4s
                add v17.4s, v7.4s, v0.4s
                sha1h s22, s19
                sha1c q19, s21, v16.4s
                sha1su1 v6.4s, v5.4s
                sha1su0 v7.4s, v4.4s, v5.4s
                add v16.4s, v4.4s, v0.4s
                sha1h s21, s19
                sha1c q19, s22, v17.4s
                sha1su1 v7.4s, v6.4s
                sha1su0 v4.4s, v5.4s, v6.4s
                add v17.4s, v5.4s, v1.4s
                sha1h s22, s19
                sha1c q19, s21, v16.4s
                sha1su1 v4.4s, v7.4s
                sha1su0 v5.4s, v6.4s, v7.4s
                add v16.4s, v6.4s, v1.4s
                sha1h s21, s19
                sha1p q19, s22, v17.4s
                sha1su1 v5.4s, v4.4s
                sha1su0 v6.4s, v7.4s, v4.4s
                add v17.4s, v7.4s, v1.4s
                sha1h s22, s19
                sha1p q19, s21, v16.4s
                sha1su1 v6.4s, v5.4s
                sha1su0 v7.4s, v4.4s, v5.4s
                add v16.4s, v4.4s, v1.4s
                sha1h s21, s19
                sha1p q19, s22, v17.4s
                sha1su1 v7.4s, v6.4s
                sha1su0 v4.4s, v5.4s, v6.4s
                add v17.4s, v5.4s, v1.4s
                sha1h s22, s19
                sha1p q19, s21, v16.4s
                sha1su1 v4.4s, v7.4s
                sha1su0 v5.4s, v6.4s, v7.4s
                add v16.4s, v6.4s, v2.4s
                sha1h s21, s19
                sha1p q19, s22, v17.4s
                sha1su1 v5.4s, v4.4s
                sha1su0 v6.4s, v7.4s, v4.4s
                add v17.4s, v7.4s, v2.4s
                sha1h s22, s19
                sha1m q19, s21, v16.4s
                sha1su1 v6.4s, v5.4s
                sha1su0 v7.4s, v4.4s, v5.4s
                add v16.4s, v4.4s, v2.4s
                sha1h s21, s19
                sha1m q19, s22, v17.4s
                sha1su1 v7.4s, v6.4s
                sha1su0 v4.4s, v5.4s, v6.4s
                add v17.4s, v5.4s, v2.4s
                sha1h s22, s19
                sha1m q19, s21, v16.4s
                sha1su1 v4.4s, v7.4s
                sha1su0 v5.4s, v6.4s, v7.4s
                add v16.4s, v6.4s, v2.4s
                sha1h s21, s19
                sha1m q19, s22, v17.4s
                sha1su1 v5.4s, v4.4s
                sha1su0 v6.4s, v7.4s, v4.4s
                add v17.4s, v7.4s, v3.4s
                sha1h s22, s19
                sha1m q19, s21, v16.4s
                sha1su1 v6.4s, v5.4s
                sha1su0 v7.4s, v4.4s, v5.4s
                add v16.4s, v4.4s, v3.4s
                sha1h s21, s19
                sha1p q19, s22, v17.4s
                sha1su1 v7.4s, v6.4s
                add v17.4s, v5.4s, v3.4s
                sha1h s22, s19
                sha1p q19, s21, v16.4s
                add v16.4s, v6.4s, v3.4s
                sha1h s21, s19
                sha1p q19, s22, v17.4s
                add v17.4s, v7.4s, v3.4s
                sha1h s22, s19
                sha1p q19, s21, v16.4s
                sha1h s21, s19
                sha1p q19, s22, v17.4s
                add v19.4s, v19.4s, v18.4s
                fmov w9, s21
                fmov w10, s23
                add w9, w9, w10
                st1 {v19.4s}, [%[state]]
                str w9, [%[state], #16]
            )sha"
            :
            : [state] "r"(state), [block] "r"(block), [k] "r"(constants)
            : "v0", "v1", "v2", "v3", "v4", "v5", "v6", "v7",
              "v16", "v17", "v18", "v19", "v21", "v22", "v23",
              "x9", "x10", "memory", "cc");
    }
#endif

    __attribute__((hot, always_inline))
    constexpr void transform_scalar(std::span<const std::byte,block_size> chunk) noexcept
    {
        // Stack allocation is fast; alignment overhead not worth it for hot path
        auto words = std::array<std::uint32_t,80>{};
        
        // Use restrict pointer for better compiler optimization
        const auto* __restrict chunk_data = chunk.data();

        // Load the first 16 big-endian words from the chunk.
        words[ 0] = (std::to_integer<std::uint32_t>(chunk_data[ 0]) << 24) bitor (std::to_integer<std::uint32_t>(chunk_data[ 1]) << 16) bitor (std::to_integer<std::uint32_t>(chunk_data[ 2]) <<  8) bitor (std::to_integer<std::uint32_t>(chunk_data[ 3])      );
        words[ 1] = (std::to_integer<std::uint32_t>(chunk_data[ 4]) << 24) bitor (std::to_integer<std::uint32_t>(chunk_data[ 5]) << 16) bitor (std::to_integer<std::uint32_t>(chunk_data[ 6]) <<  8) bitor (std::to_integer<std::uint32_t>(chunk_data[ 7])      );
        words[ 2] = (std::to_integer<std::uint32_t>(chunk_data[ 8]) << 24) bitor (std::to_integer<std::uint32_t>(chunk_data[ 9]) << 16) bitor (std::to_integer<std::uint32_t>(chunk_data[10]) <<  8) bitor (std::to_integer<std::uint32_t>(chunk_data[11])      );
        words[ 3] = (std::to_integer<std::uint32_t>(chunk_data[12]) << 24) bitor (std::to_integer<std::uint32_t>(chunk_data[13]) << 16) bitor (std::to_integer<std::uint32_t>(chunk_data[14]) <<  8) bitor (std::to_integer<std::uint32_t>(chunk_data[15])      );
        words[ 4] = (std::to_integer<std::uint32_t>(chunk_data[16]) << 24) bitor (std::to_integer<std::uint32_t>(chunk_data[17]) << 16) bitor (std::to_integer<std::uint32_t>(chunk_data[18]) <<  8) bitor (std::to_integer<std::uint32_t>(chunk_data[19])      );
        words[ 5] = (std::to_integer<std::uint32_t>(chunk_data[20]) << 24) bitor (std::to_integer<std::uint32_t>(chunk_data[21]) << 16) bitor (std::to_integer<std::uint32_t>(chunk_data[22]) <<  8) bitor (std::to_integer<std::uint32_t>(chunk_data[23])      );
        words[ 6] = (std::to_integer<std::uint32_t>(chunk_data[24]) << 24) bitor (std::to_integer<std::uint32_t>(chunk_data[25]) << 16) bitor (std::to_integer<std::uint32_t>(chunk_data[26]) <<  8) bitor (std::to_integer<std::uint32_t>(chunk_data[27])      );
        words[ 7] = (std::to_integer<std::uint32_t>(chunk_data[28]) << 24) bitor (std::to_integer<std::uint32_t>(chunk_data[29]) << 16) bitor (std::to_integer<std::uint32_t>(chunk_data[30]) <<  8) bitor (std::to_integer<std::uint32_t>(chunk_data[31])      );
        words[ 8] = (std::to_integer<std::uint32_t>(chunk_data[32]) << 24) bitor (std::to_integer<std::uint32_t>(chunk_data[33]) << 16) bitor (std::to_integer<std::uint32_t>(chunk_data[34]) <<  8) bitor (std::to_integer<std::uint32_t>(chunk_data[35])      );
        words[ 9] = (std::to_integer<std::uint32_t>(chunk_data[36]) << 24) bitor (std::to_integer<std::uint32_t>(chunk_data[37]) << 16) bitor (std::to_integer<std::uint32_t>(chunk_data[38]) <<  8) bitor (std::to_integer<std::uint32_t>(chunk_data[39])      );
        words[10] = (std::to_integer<std::uint32_t>(chunk_data[40]) << 24) bitor (std::to_integer<std::uint32_t>(chunk_data[41]) << 16) bitor (std::to_integer<std::uint32_t>(chunk_data[42]) <<  8) bitor (std::to_integer<std::uint32_t>(chunk_data[43])      );
        words[11] = (std::to_integer<std::uint32_t>(chunk_data[44]) << 24) bitor (std::to_integer<std::uint32_t>(chunk_data[45]) << 16) bitor (std::to_integer<std::uint32_t>(chunk_data[46]) <<  8) bitor (std::to_integer<std::uint32_t>(chunk_data[47])      );
        words[12] = (std::to_integer<std::uint32_t>(chunk_data[48]) << 24) bitor (std::to_integer<std::uint32_t>(chunk_data[49]) << 16) bitor (std::to_integer<std::uint32_t>(chunk_data[50]) <<  8) bitor (std::to_integer<std::uint32_t>(chunk_data[51])      );
        words[13] = (std::to_integer<std::uint32_t>(chunk_data[52]) << 24) bitor (std::to_integer<std::uint32_t>(chunk_data[53]) << 16) bitor (std::to_integer<std::uint32_t>(chunk_data[54]) <<  8) bitor (std::to_integer<std::uint32_t>(chunk_data[55])      );
        words[14] = (std::to_integer<std::uint32_t>(chunk_data[56]) << 24) bitor (std::to_integer<std::uint32_t>(chunk_data[57]) << 16) bitor (std::to_integer<std::uint32_t>(chunk_data[58]) <<  8) bitor (std::to_integer<std::uint32_t>(chunk_data[59])      );
        words[15] = (std::to_integer<std::uint32_t>(chunk_data[60]) << 24) bitor (std::to_integer<std::uint32_t>(chunk_data[61]) << 16) bitor (std::to_integer<std::uint32_t>(chunk_data[62]) <<  8) bitor (std::to_integer<std::uint32_t>(chunk_data[63])      );

#if defined(CRYPTIC_UNROLL_SCALAR)
#pragma clang loop unroll(full)
#endif
        for(auto i = 16uz; i < 32uz; ++i)
        {
            const auto w3 = words[i - 3];
            const auto w8 = words[i - 8];
            const auto w14 = words[i - 14];
            const auto w16 = words[i - 16];
            words[i] = std::rotl(w3 xor w8 xor w14 xor w16, 1);
        }

#if defined(CRYPTIC_UNROLL_SCALAR)
#pragma clang loop unroll(full)
#endif
        for(auto i = 32uz; i < 80uz; ++i)
        {
            const auto w6 = words[i - 6];
            const auto w16 = words[i - 16];
            const auto w28 = words[i - 28];
            const auto w32 = words[i - 32];
            words[i] = std::rotl(w6 xor w16 xor w28 xor w32, 2);
        }

        auto a = m_message_digest[0],
             b = m_message_digest[1],
             c = m_message_digest[2],
             d = m_message_digest[3],
             e = m_message_digest[4],
             f = 0u,
             k = 0u;

        k = 0x5A827999u;
#if defined(CRYPTIC_UNROLL_SCALAR)
#pragma clang loop unroll(full)
#endif
        for(auto i = 0uz; i < 20uz; ++i)
        {
            f = (b bitand c) bitor ((compl b) bitand d);
            const auto temp = std::rotl(a, 5) + f + e + k + words[i];
            e = d;
            d = c;
            c = std::rotl(b, 30);
            b = a;
            a = temp;
        }

        k = 0x6ED9EBA1u;
#if defined(CRYPTIC_UNROLL_SCALAR)
#pragma clang loop unroll(full)
#endif
        for(auto i = 20uz; i < 40uz; ++i)
        {
            f = b xor c xor d;
            const auto temp = std::rotl(a, 5) + f + e + k + words[i];
            e = d;
            d = c;
            c = std::rotl(b, 30);
            b = a;
            a = temp;
        }

        k = 0x8F1BBCDCu;
#if defined(CRYPTIC_UNROLL_SCALAR)
#pragma clang loop unroll(full)
#endif
        for(auto i = 40uz; i < 60uz; ++i)
        {
            f = (b bitand c) bitor ((b xor c) bitand d);
            const auto temp = std::rotl(a, 5) + f + e + k + words[i];
            e = d;
            d = c;
            c = std::rotl(b, 30);
            b = a;
            a = temp;
        }

        k = 0xCA62C1D6u;
#if defined(CRYPTIC_UNROLL_SCALAR)
#pragma clang loop unroll(full)
#endif
        for(auto i = 60uz; i < 80uz; ++i)
        {
            f = b xor c xor d;
            const auto temp = std::rotl(a, 5) + f + e + k + words[i];
            e = d;
            d = c;
            c = std::rotl(b, 30);
            b = a;
            a = temp;
        }

        m_message_digest[0] += a;
        m_message_digest[1] += b;
        m_message_digest[2] += c;
        m_message_digest[3] += d;
        m_message_digest[4] += e;
    }

    static constexpr void encode(std::span<std::byte,8> output, const message_length_type length) noexcept
    {
    	output[7] = static_cast<std::byte>(length >>  0);
    	output[6] = static_cast<std::byte>(length >>  8);
    	output[5] = static_cast<std::byte>(length >> 16);
    	output[4] = static_cast<std::byte>(length >> 24);
    	output[3] = static_cast<std::byte>(length >> 32);
    	output[2] = static_cast<std::byte>(length >> 40);
    	output[1] = static_cast<std::byte>(length >> 48);
    	output[0] = static_cast<std::byte>(length >> 56);
    }

    alignas(16) static constexpr std::array<std::uint32_t, 4> round_k =
    {
        0x5A827999u, 0x6ED9EBA1u, 0x8F1BBCDCu, 0xCA62C1D6u
    };

    message_length_type m_message_length = 0;

    std::array<std::uint32_t,5> m_message_digest = {0x67452301u,
                                                    0xEFCDAB89u,
                                                    0x98BADCFEu,
                                                    0x10325476u,
                                                    0xC3D2E1F0u};

    std::array<std::byte,block_size> m_pending = {};
};

} // namespace cryptic

