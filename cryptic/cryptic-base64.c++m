export module cryptic:base64;
import std;
import :details;

namespace cryptic::details {

    // The character for a six-bit index, and '=' for 64.
    inline constexpr char base64_character(std::byte index)
    {
        expects(index < std::byte{65});
        constexpr auto set = std::to_array("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/=");
        return set[std::to_integer<std::size_t>(index)];
    }

    // The six-bit index of a character, or -1 for anything outside the alphabet, '=' included.
    constexpr int base64_value(char c) noexcept
    {
        if(c >= 'A' and c <= 'Z') return c - 'A';
        if(c >= 'a' and c <= 'z') return c - 'a' + 26;
        if(c >= '0' and c <= '9') return c - '0' + 52;
        if(c == '+') return 62;
        if(c == '/') return 63;
        return -1;
    }

} // namespace cryptic::details

export namespace cryptic::base64 {

    constexpr std::string encode(std::span<const std::byte> bytes)
    {
        auto encoded = std::string{};
        encoded.reserve((bytes.size() + 2) / 3 * 4);

        while(bytes.size() > 0)
        {
            auto index1 = (bytes[0] bitand std::byte{0b11111100}) >> 2,
                 index2 = (bytes[0] bitand std::byte{0b00000011}) << 4,
                 index3 = std::byte{64},
                 index4 = std::byte{64};

            if(bytes.size() > 1)
            {
                index2 |= (bytes[1] bitand std::byte{0b11110000}) >> 4;
                index3  = (bytes[1] bitand std::byte{0b00001111}) << 2;
            }

            if(bytes.size() > 2)
            {
                index3 |= (bytes[2] bitand std::byte{0b11000000}) >> 6;
                index4  = (bytes[2] bitand std::byte{0b00111111});
            }

            encoded.push_back(details::base64_character(index1));
            encoded.push_back(details::base64_character(index2));
            encoded.push_back(details::base64_character(index3));
            encoded.push_back(details::base64_character(index4));

            bytes = bytes.subspan(std::min<std::size_t>(3, bytes.size()));
        }

        return encoded;
    }

    template<details::byte_message Source>
    constexpr std::string encode(Source&& source)
    {
        return encode(details::to_bytes_span(source));
    }

    enum class decode_error
    {
        invalid_length,    // not a multiple of four characters
        invalid_character, // outside the base64 alphabet
        invalid_padding,   // '=' anywhere but the last one or two characters
    };

    // Padded input in the standard alphabet only.
    constexpr std::expected<std::string, decode_error> decode(std::string_view source)
    {
        if(source.size() % 4 != 0)
            return std::unexpected{decode_error::invalid_length};

        auto decoded = std::string{};
        decoded.reserve(source.size() / 4 * 3);

        for(auto offset = 0uz; offset < source.size(); offset += 4)
        {
            const auto group = source.substr(offset, 4);
            const auto padding = offset + 4 < source.size() ? 0uz
                               : group.ends_with("==")      ? 2uz
                               : group.ends_with('=')       ? 1uz
                               :                              0uz;

            auto bits = 0u;
            for(auto i = 0uz; i < 4; ++i)
            {
                const auto value = i < 4 - padding ? details::base64_value(group[i]) : 0;
                if(value < 0)
                    return std::unexpected{group[i] == '=' ? decode_error::invalid_padding
                                                           : decode_error::invalid_character};
                bits = (bits << 6) bitor static_cast<unsigned>(value);
            }

            decoded.push_back(static_cast<char>(bits >> 16));
            if(padding < 2)
                decoded.push_back(static_cast<char>((bits >> 8) bitand 0xFFu));
            if(padding < 1)
                decoded.push_back(static_cast<char>(bits bitand 0xFFu));
        }

        return decoded;
    }

    [[deprecated("decode() reports errors since v3.0.0; call it instead")]]
    constexpr std::expected<std::string, decode_error> try_decode(std::string_view source)
    {
        return decode(source);
    }

} // namespace cryptic::base64
